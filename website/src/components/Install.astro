---
import { Icon } from 'astro-icon/components';
import {
  LATEST_RELEASE_URL,
  RELEASES_URL,
  WINGET_ID,
  PLATFORMS,
  DOCKER_IMAGE,
  GHCR_URL,
  REPO_URL,
} from '../consts';

const DOCKER_RUN = `docker run -d -p 8080:8080 \\
  -e ANYBUCKET_MASTER_KEY=$(openssl rand -hex 32) \\
  -v anybucket-config:/config \\
  ${DOCKER_IMAGE}`;

const icons: Record<string, string> = {
  windows: 'simple-icons:windows',
  macos: 'simple-icons:apple',
  linux: 'simple-icons:linux',
};
---

<section id="install" class="scroll-mt-20 border-t border-night-800 bg-night-950 py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Install AnyBucket</h2>
      <p class="mt-4 text-lg text-ink-muted">
        Free and open source. Available as a native application or Docker image for web deployment —
        <span id="install-version" class="text-ink">the latest version</span>.
      </p>
    </div>

    <h3 class="mt-14 text-center text-sm font-semibold uppercase tracking-wide text-ink-faint">Desktop app</h3>

    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {PLATFORMS.map((p) => (
        <div
          data-platform={p.id}
          class="platform-card relative flex flex-col rounded-xl border border-night-700 bg-night-900 p-6"
        >
          <div
            class="recommended-badge absolute -top-2.5 right-4 hidden rounded-full bg-brand-500 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white"
          >
            Your system
          </div>
          <div class="flex items-center gap-3">
            <Icon name={icons[p.id]} width="26" height="26" aria-hidden="true" class="text-ink" />
            <div>
              <h3 class="font-semibold">{p.name}</h3>
              <p class="text-xs text-ink-faint">{p.note}</p>
            </div>
          </div>

          {p.id === 'windows' ? (
            <div class="mt-5">
              <p class="text-xs font-medium text-ink-muted">Install with WinGet</p>
              <div class="mt-1.5 flex items-center gap-2 rounded-md border border-night-700 bg-night-950 px-3 py-2 font-mono text-xs">
                <span class="truncate">winget install {WINGET_ID}</span>
                <button
                  type="button"
                  class="copy-btn ml-auto shrink-0 rounded px-1.5 py-0.5 text-ink-faint transition hover:bg-night-800 hover:text-ink"
                  data-copy={`winget install ${WINGET_ID}`}
                  aria-label="Copy command"
                >
                  <Icon name="heroicons:document-duplicate-16-solid" width="14" height="14" aria-hidden="true" />
                </button>
              </div>
              <p class="mt-3 text-xs text-ink-faint">or download the installer:</p>
            </div>
          ) : (
            <p class="mt-5 text-xs text-ink-muted">{p.blurb}</p>
          )}

          <a
            href={LATEST_RELEASE_URL}
            data-download={p.id}
            class="download-link mt-3 inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600"
          >
            <Icon name="heroicons:arrow-down-tray-20-solid" width="16" height="16" aria-hidden="true" />
            <span class="download-label">Download</span>
          </a>
          <a
            href={LATEST_RELEASE_URL}
            target="_blank"
            rel="noopener"
            class="mt-2 text-center text-xs text-ink-faint underline-offset-2 hover:text-ink-muted hover:underline"
          >
            All assets &amp; checksums
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-ink-faint">
      Looking for older versions? Browse
      <a href={RELEASES_URL} target="_blank" rel="noopener" class="text-brand-400 hover:underline">all releases</a>.
    </p>

    <!-- Self-hosted web app -->
    <h3
      id="self-hosted"
      class="mt-20 scroll-mt-20 text-center text-sm font-semibold uppercase tracking-wide text-ink-faint"
    >
      Self-hosted web app
    </h3>

    <div class="mx-auto mt-6 max-w-3xl rounded-xl border border-night-700 bg-night-900 p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-500/15 text-brand-400">
          <Icon name="heroicons:server-solid" width="24" height="24" aria-hidden="true" />
        </div>
        <div>
          <h4 class="font-semibold">Run the same UI as a single container</h4>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">
            An <span class="text-ink">axum</span> server serves the SPA and performs all S3
            operations server-side — the browser never talks to S3 directly. Published to the GitHub
            Container Registry for <span class="text-ink">linux/amd64</span> and
            <span class="text-ink">linux/arm64</span>.
          </p>
        </div>
      </div>

      <p class="mt-6 text-xs font-medium text-ink-muted">Start with Docker</p>
      <div class="mt-1.5 flex items-start gap-2 rounded-md border border-night-700 bg-night-950 px-3 py-3 font-mono text-xs leading-relaxed">
        <pre class="overflow-x-auto whitespace-pre text-ink">{DOCKER_RUN}</pre>
        <button
          type="button"
          class="copy-btn ml-auto shrink-0 rounded px-1.5 py-0.5 text-ink-faint transition hover:bg-night-800 hover:text-ink"
          data-copy={DOCKER_RUN}
          aria-label="Copy command"
        >
          <Icon name="heroicons:document-duplicate-16-solid" width="14" height="14" aria-hidden="true" />
        </button>
      </div>

      <div class="mt-4 flex items-start gap-2 rounded-md border border-amber-500/30 bg-amber-500/10 px-3 py-2.5 text-xs text-amber-200/90">
        <Icon name="heroicons:exclamation-triangle-20-solid" width="16" height="16" aria-hidden="true" class="mt-0.5 shrink-0 text-amber-400" />
        <span>
          There is <span class="font-semibold">no built-in auth</span> — run it behind a reverse
          proxy that provides authentication and TLS. Set <span class="font-mono">ANYBUCKET_MASTER_KEY</span>
          to encrypt stored secret keys at rest, and back it up alongside the config volume.
        </span>
      </div>
    </div>
  </div>
</section>
