---
import { LATEST_RELEASE_URL, RELEASES_URL, WINGET_ID, PLATFORMS } from '../consts';

const icons: Record<string, string> = {
  windows: '<path d="M0 3.4 9.8 2v9.3H0V3.4Zm10.9-1.6L24 0v11.2H10.9V1.8ZM0 12.5h9.8v9.3L0 20.5v-8Zm10.9 0H24V24l-13.1-1.8v-9.7Z"/>',
  macos: '<path d="M16.7 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9s-1.8-.9-3-.8c-1.5 0-2.9.9-3.7 2.3-1.6 2.7-.4 6.8 1.1 9 .7 1.1 1.6 2.3 2.8 2.2 1.1 0 1.5-.7 2.9-.7s1.7.7 2.9.7 2-1.1 2.7-2.1c.9-1.2 1.2-2.4 1.2-2.5-.1 0-2.3-.9-2.3-3.5Zm-2.3-6.4c.6-.8 1-1.8.9-2.9-.9 0-2 .6-2.6 1.3-.6.7-1.1 1.7-1 2.7 1 .1 2-.4 2.7-1.1Z"/>',
  linux: '<path d="M12 2c-2 0-3 1.7-3 3.6 0 1 .2 1.6.2 2.4 0 .8-.9 1.6-1.7 3-.8 1.3-2 2.7-2 4.6 0 .6.2 1.1.5 1.5-.2.5-.3 1-.1 1.4.4.8 1.6.9 2.7 1.1.6.1 1.2.5 1.8.7.6.2 1.2.2 1.6.2.4 0 1 0 1.6-.2.6-.2 1.2-.6 1.8-.7 1.1-.2 2.3-.3 2.7-1.1.2-.4.1-.9-.1-1.4.3-.4.5-.9.5-1.5 0-1.9-1.2-3.3-2-4.6-.8-1.4-1.7-2.2-1.7-3 0-.8.2-1.4.2-2.4C15 3.7 14 2 12 2Z"/>',
};
---

<section id="install" class="scroll-mt-20 border-t border-night-800 bg-night-950 py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Install AnyBucket</h2>
      <p class="mt-4 text-lg text-ink-muted">
        Free and open source. Download the build for your platform from the latest GitHub release —
        <span id="install-version" class="text-ink">the latest version</span>.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {PLATFORMS.map((p) => (
        <div
          data-platform={p.id}
          class="platform-card relative flex flex-col rounded-xl border border-night-700 bg-night-900 p-6"
        >
          <div
            class="recommended-badge absolute -top-2.5 right-4 hidden rounded-full bg-brand-500 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white"
          >
            Your system
          </div>
          <div class="flex items-center gap-3">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true" class="text-ink" set:html={icons[p.id]} />
            <div>
              <h3 class="font-semibold">{p.name}</h3>
              <p class="text-xs text-ink-faint">{p.note}</p>
            </div>
          </div>

          {p.id === 'windows' ? (
            <div class="mt-5">
              <p class="text-xs font-medium text-ink-muted">Install with WinGet</p>
              <div class="mt-1.5 flex items-center gap-2 rounded-md border border-night-700 bg-night-950 px-3 py-2 font-mono text-xs">
                <span class="truncate">winget install {WINGET_ID}</span>
                <button
                  type="button"
                  class="copy-btn ml-auto shrink-0 rounded px-1.5 py-0.5 text-ink-faint transition hover:bg-night-800 hover:text-ink"
                  data-copy={`winget install ${WINGET_ID}`}
                  aria-label="Copy command"
                >
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4 2a2 2 0 0 0-2 2v7h1.5V4a.5.5 0 0 1 .5-.5h6V2H4Z"/><path d="M6 5a1.5 1.5 0 0 0-1.5 1.5v6A1.5 1.5 0 0 0 6 14h6a1.5 1.5 0 0 0 1.5-1.5v-6A1.5 1.5 0 0 0 12 5H6Z"/></svg>
                </button>
              </div>
              <p class="mt-3 text-xs text-ink-faint">or download the installer:</p>
            </div>
          ) : (
            <p class="mt-5 text-xs text-ink-muted">{p.blurb}</p>
          )}

          <a
            href={LATEST_RELEASE_URL}
            data-download={p.id}
            class="download-link mt-3 inline-flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600"
          >
            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M10 2.5a.75.75 0 0 1 .75.75v7.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 1 1 1.06-1.06l2.72 2.72V3.25A.75.75 0 0 1 10 2.5Z"/><path d="M3.5 14.5a.75.75 0 0 1 .75.75v.5a.75.75 0 0 0 .75.75h10a.75.75 0 0 0 .75-.75v-.5a.75.75 0 0 1 1.5 0v.5A2.25 2.25 0 0 1 15 17.5H5a2.25 2.25 0 0 1-2.25-2.25v-.5a.75.75 0 0 1 .75-.75Z"/></svg>
            <span class="download-label">Download</span>
          </a>
          <a
            href={LATEST_RELEASE_URL}
            target="_blank"
            rel="noopener"
            class="mt-2 text-center text-xs text-ink-faint underline-offset-2 hover:text-ink-muted hover:underline"
          >
            All assets &amp; checksums
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-ink-faint">
      Looking for older versions? Browse
      <a href={RELEASES_URL} target="_blank" rel="noopener" class="text-brand-400 hover:underline">all releases</a>.
    </p>
  </div>
</section>
