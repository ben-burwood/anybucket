---
import { Icon } from 'astro-icon/components';

const features = [
  {
    title: 'Works with any S3 store',
    body: 'AWS S3 and every S3-compatible backend — RustFS, Garage, MinIO and more — via custom endpoints and path-style addressing.',
    icon: 'cloud',
    highlight: true,
  },
  {
    title: 'Secrets stay protected',
    body: 'On the desktop, access keys live in your OS keychain. Self-hosted, they are AES-256-GCM encrypted at rest under a master key — never in plaintext.',
    icon: 'lock',
    highlight: true,
  },
  {
    title: 'Desktop app or self-hosted',
    body: 'Run the native desktop build, or self-host the same UI as a single Docker container — an axum server that talks to S3 server-side, sharing the same Rust core.',
    icon: 'server',
    highlight: true,
  },
  {
    title: 'Safe by default',
    body: 'Per-connection access modes — read-only, read-write, or read-write-delete — enforced in the Rust backend, not just the UI.',
    icon: 'shield',
    highlight: true,
  },
  {
    title: 'Native & lightweight',
    body: 'Built with Tauri and Rust, not Electron — a small binary and low memory footprint that feels instant.',
    icon: 'bolt',
  },
  {
    title: 'Folder-style browser',
    body: 'Navigate buckets and prefixes like folders, with object versions, delete markers, and a full metadata panel.',
    icon: 'folder',
  },
  {
    title: 'One-click object actions',
    body: 'Copy s3:// URIs and HTTPS URLs, generate presigned GET links, and stream-download straight to disk.',
    icon: 'link',
  },
  {
    title: 'Streaming uploads',
    body: 'Multipart uploads for large files and recursive folder uploads that preserve structure — all with live progress.',
    icon: 'upload',
  },
  {
    title: 'Copy, move & delete',
    body: 'Move or copy objects and whole folders across buckets, and delete with a running progress count.',
    icon: 'move',
  },
  {
    title: 'Create & delete buckets',
    body: 'Provision new buckets and remove empty ones right from the app — an opt-in admin capability set per connection.',
    icon: 'bucket',
  },
  {
    title: 'Bucket metrics',
    body: 'Scan a bucket for its exact total size and object count, paginated with live progress.',
    icon: 'chart',
  },
];

const icons: Record<string, string> = {
  cloud: 'heroicons:cloud-solid',
  lock: 'heroicons:lock-closed-solid',
  shield: 'heroicons:shield-check-solid',
  bolt: 'heroicons:bolt-solid',
  folder: 'heroicons:folder-solid',
  link: 'heroicons:link-solid',
  upload: 'heroicons:arrow-up-tray-solid',
  move: 'heroicons:arrows-pointing-out-solid',
  chart: 'heroicons:chart-bar-solid',
  server: 'heroicons:server-solid',
  bucket: 'heroicons:archive-box-solid',
};
---

<section id="features" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Everything you need to manage buckets</h2>
    <p class="mt-4 text-lg text-ink-muted">
      A focused, native tool for day-to-day object storage work — without the AWS console.
    </p>
  </div>

  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <div
        class:list={[
          'group rounded-xl border bg-night-900 p-5 transition hover:bg-night-850',
          f.highlight ? 'border-brand-500/30' : 'border-night-700',
        ]}
      >
        <div
          class:list={[
            'flex h-10 w-10 items-center justify-center rounded-lg',
            f.highlight ? 'bg-brand-500/15 text-brand-400' : 'bg-night-800 text-ink-muted',
          ]}
        >
          <Icon name={icons[f.icon]} width="22" height="22" aria-hidden="true" />
        </div>
        <h3 class="mt-4 font-semibold">{f.title}</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{f.body}</p>
      </div>
    ))}
  </div>
</section>
