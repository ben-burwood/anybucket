---
// Focused UI mockups of key screens. Swap any panel for a real capture
// (drop a PNG in public/screenshots and replace the panel markup with an <img>).
---

<section class="mx-auto max-w-6xl px-5 py-16">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">A closer look</h2>
    <p class="mt-4 text-lg text-ink-muted">
      Purpose-built panels for connecting, transferring, and inspecting objects.
    </p>
  </div>

  <div class="mt-12 grid gap-5 lg:grid-cols-3">
    <!-- Connections -->
    <figure class="overflow-hidden rounded-xl border border-night-700 bg-night-900">
      <div class="border-b border-night-700 px-4 py-3 text-sm font-medium">Connections</div>
      <div class="space-y-3 p-4 text-xs">
        <div>
          <div class="mb-1 text-ink-faint">Name</div>
          <div class="rounded-md border border-night-700 bg-night-950 px-2.5 py-2">Production</div>
        </div>
        <div>
          <div class="mb-1 text-ink-faint">Endpoint</div>
          <div class="rounded-md border border-night-700 bg-night-950 px-2.5 py-2">https://s3.eu-west-1.amazonaws.com</div>
        </div>
        <div class="flex gap-3">
          <div class="flex-1">
            <div class="mb-1 text-ink-faint">Access mode</div>
            <div class="flex gap-1">
              <span class="rounded bg-night-800 px-2 py-1 text-[10px] text-ink-faint">RO</span>
              <span class="rounded bg-night-800 px-2 py-1 text-[10px] text-ink-faint">RW</span>
              <span class="rounded bg-rose-500/15 px-2 py-1 text-[10px] font-bold text-rose-400">RWD</span>
            </div>
          </div>
          <div class="flex items-end">
            <label class="flex items-center gap-1.5 text-[10px] text-ink-muted">
              <span class="h-3.5 w-3.5 rounded-sm border border-brand-500 bg-brand-500/30"></span>
              Path-style
            </label>
          </div>
        </div>
        <div class="flex items-center gap-2 pt-1">
          <span class="rounded-md bg-brand-500 px-3 py-1.5 text-[11px] font-semibold text-white">Save</span>
          <span class="inline-flex items-center gap-1 text-[11px] text-brand-400">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span> Connection OK
          </span>
        </div>
      </div>
    </figure>

    <!-- Upload progress -->
    <figure class="overflow-hidden rounded-xl border border-night-700 bg-night-900">
      <div class="border-b border-night-700 px-4 py-3 text-sm font-medium">Live transfer progress</div>
      <div class="space-y-3 p-4 text-xs">
        {[
          { name: 'archive-2025.tar.zst', pct: 72, note: '936 MB / 1.3 GB' },
          { name: 'data-export.csv', pct: 100, note: 'Uploaded', done: true },
          { name: 'images/ (128 files)', pct: 41, note: '53 / 128' },
        ].map((u) => (
          <div class="rounded-lg border border-night-700 bg-night-950 p-2.5">
            <div class="flex items-center justify-between">
              <span class="truncate pr-2 text-ink">{u.name}</span>
              <span class:list={['tabular-nums', u.done ? 'text-brand-400' : 'text-ink-faint']}>{u.note}</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-night-800">
              <div class="h-full rounded-full bg-brand-500" style={`width:${u.pct}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </figure>

    <!-- Object detail -->
    <figure class="overflow-hidden rounded-xl border border-night-700 bg-night-900">
      <div class="border-b border-night-700 px-4 py-3 text-sm font-medium">Object detail</div>
      <div class="p-4 text-xs">
        <div class="flex items-center gap-2 border-b border-night-800 pb-3">
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true" class="text-ink-faint"><path d="M4 1.5A1.5 1.5 0 0 0 2.5 3v10A1.5 1.5 0 0 0 4 14.5h8a1.5 1.5 0 0 0 1.5-1.5V6L9 1.5H4Z"/></svg>
          <span class="truncate font-medium">app-v0.4.1-setup.exe</span>
        </div>
        <dl class="mt-3 space-y-2">
          {[
            ['Size', '8.7 MB'],
            ['Content-Type', 'application/octet-stream'],
            ['Storage class', 'STANDARD'],
            ['ETag', 'd41d8cd9…f204'],
            ['Modified', '2 hours ago'],
          ].map(([k, v]) => (
            <div class="flex justify-between gap-3">
              <dt class="text-ink-faint">{k}</dt>
              <dd class="truncate tabular-nums text-ink-muted">{v}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-4 grid grid-cols-2 gap-1.5">
          <span class="rounded-md border border-night-700 px-2 py-1.5 text-center text-[11px] text-ink-muted">Copy s3:// URI</span>
          <span class="rounded-md border border-night-700 px-2 py-1.5 text-center text-[11px] text-ink-muted">Copy HTTPS URL</span>
          <span class="rounded-md bg-brand-500/15 px-2 py-1.5 text-center text-[11px] font-medium text-brand-400">Presigned link</span>
          <span class="rounded-md border border-night-700 px-2 py-1.5 text-center text-[11px] text-ink-muted">Download</span>
        </div>
      </div>
    </figure>
  </div>

  <p class="mt-6 text-center text-xs text-ink-faint">Interface shown with sample data.</p>
</section>
