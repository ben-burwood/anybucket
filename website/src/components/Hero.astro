---
import { REPO_URL } from '../consts';
import WindowMock from './WindowMock.astro';
---

<section id="top" class="relative overflow-hidden">
  <!-- Ambient green glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -top-40 -z-10 mx-auto h-[500px] max-w-4xl rounded-full bg-brand-500/20 blur-[120px]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-10 pt-16 sm:pt-24">
    <div class="mx-auto max-w-3xl text-center">
      <a
        href="#install"
        class="inline-flex items-center gap-2 rounded-full border border-night-700 bg-night-900 px-3 py-1 text-xs font-medium text-ink-muted transition hover:border-brand-500/60 hover:text-ink"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
        <span id="hero-version">Latest release</span>
        <span class="text-ink-faint">·</span>
        <span>macOS · Windows · Linux · Docker</span>
      </a>

      <h1 class="mt-6 text-balance text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
        The explorer for
        <span class="bg-gradient-to-r from-brand-400 to-brand-emerald bg-clip-text text-transparent">
          S3-compatible</span
        > storage
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-pretty text-lg text-ink-muted sm:text-xl">
        Browse buckets, manage objects, and move data with live progress — for AWS S3 and any
        S3-compatible store like <span class="text-ink">RustFS</span>, <span class="text-ink"
          >Garage</span
        > and MinIO.
        </br>Run it as a native <span class="text-ink">desktop app</span>, or
        <span class="text-ink">self-host</span> as a single-container web app.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#install"
          class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/20 transition hover:bg-brand-600"
        >
          <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M10 2.5a.75.75 0 0 1 .75.75v7.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-4 4a.75.75 0 0 1-1.06 0l-4-4a.75.75 0 1 1 1.06-1.06l2.72 2.72V3.25A.75.75 0 0 1 10 2.5Z"/>
            <path d="M3.5 14.5a.75.75 0 0 1 .75.75v.5a.75.75 0 0 0 .75.75h10a.75.75 0 0 0 .75-.75v-.5a.75.75 0 0 1 1.5 0v.5A2.25 2.25 0 0 1 15 17.5H5a2.25 2.25 0 0 1-2.25-2.25v-.5a.75.75 0 0 1 .75-.75Z"/>
          </svg>
          Download for <span id="dl-os" class="underline-offset-2">your OS</span>
        </a>
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg border border-night-700 bg-night-900 px-5 py-3 text-sm font-semibold text-ink transition hover:border-night-600 hover:bg-night-800"
        >
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          View on GitHub
        </a>
      </div>

      <p class="mt-4 text-xs text-ink-faint">Free &amp; open source · MIT licensed</p>
    </div>

    <!-- Product visual -->
    <div class="mt-14 sm:mt-16">
      <WindowMock />
    </div>
  </div>
</section>
