---
import { Icon } from 'astro-icon/components';
import { asset } from '../consts';

const buckets = [
  { name: 'prod-assets', active: true },
  { name: 'user-uploads', active: false },
  { name: 'db-backups', active: false },
  { name: 'static-site', active: false },
  { name: 'logs-archive', active: false },
];

const rows = [
  { icon: 'folder', name: 'images/', size: '—', modified: '—', klass: 'STANDARD', muted: true },
  { icon: 'folder', name: 'fonts/', size: '—', modified: '—', klass: 'STANDARD', muted: true },
  { icon: 'file', name: 'app-v0.4.1-setup.exe', size: '8.7 MB', modified: '2 hours ago', klass: 'STANDARD', selected: true },
  { icon: 'file', name: 'release-notes.md', size: '4.1 KB', modified: 'Yesterday', klass: 'STANDARD' },
  { icon: 'file', name: 'archive-2025.tar.zst', size: '1.3 GB', modified: 'Mar 4', klass: 'GLACIER' },
  { icon: 'file', name: 'logo.svg', size: '2.0 KB', modified: 'Mar 1', klass: 'STANDARD' },
  { icon: 'file', name: 'data-export.csv', size: '214 MB', modified: 'Feb 27', klass: 'STANDARD_IA' },
];
---

<div
  class="mx-auto max-w-5xl overflow-hidden rounded-xl border border-night-700 bg-night-900 shadow-2xl shadow-black/50 ring-1 ring-white/5"
>
  <!-- Title bar (frameless custom chrome) -->
  <div class="flex items-center justify-between border-b border-night-700 bg-night-900 px-4 py-2.5">
    <div class="flex items-center gap-2.5">
      <img src={asset('/bucket.svg')} alt="" width="16" height="16" class="h-4 w-4" />
      <span class="text-xs font-medium text-ink-muted">AnyBucket</span>
    </div>
    <div class="flex items-center gap-2 text-ink-faint">
      <span class="h-3 w-3 rounded-sm border border-night-600"></span>
      <span class="h-3 w-3 rounded-sm border border-night-600"></span>
      <span class="h-3 w-3 rounded-sm border border-night-600"></span>
    </div>
  </div>

  <div class="grid grid-cols-[190px_1fr] max-sm:grid-cols-1">
    <!-- Sidebar -->
    <aside class="border-r border-night-700 bg-night-950/40 p-3 max-sm:hidden">
      <div class="rounded-lg border border-night-700 bg-night-900 p-2.5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold">Production</span>
          <span class="rounded bg-rose-500/15 px-1.5 py-0.5 text-[10px] font-bold text-rose-400">RWD</span>
        </div>
        <div class="mt-1 truncate text-[10px] text-ink-faint">s3.eu-west-1.amazonaws.com</div>
      </div>

      <div class="mt-4 px-1 text-[10px] font-semibold uppercase tracking-wider text-ink-faint">Buckets</div>
      <ul class="mt-1.5 space-y-0.5">
        {buckets.map((b) => (
          <li>
            <span
              class:list={[
                'flex items-center gap-2 rounded-md px-2 py-1.5 text-xs',
                b.active ? 'bg-brand-500/15 font-medium text-brand-400' : 'text-ink-muted',
              ]}
            >
              <Icon name="heroicons:archive-box-16-solid" width="13" height="13" aria-hidden="true" class="shrink-0" />
              {b.name}
            </span>
          </li>
        ))}
      </ul>
    </aside>

    <!-- Main -->
    <div class="min-w-0">
      <!-- Toolbar -->
      <div class="flex items-center justify-between gap-3 border-b border-night-700 px-3 py-2">
        <div class="flex items-center gap-1.5 truncate text-xs text-ink-muted">
          <span class="text-brand-400">prod-assets</span>
          <span class="text-ink-faint">/</span>
          <span>releases</span>
          <span class="text-ink-faint">/</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="inline-flex items-center gap-1 rounded-md bg-brand-500 px-2.5 py-1 text-[11px] font-semibold text-white">
            <Icon name="heroicons:arrow-up-tray-16-solid" width="12" height="12" aria-hidden="true" />
            Upload
          </span>
          <span class="rounded-md border border-night-700 px-2.5 py-1 text-[11px] text-ink-muted">New folder</span>
        </div>
      </div>

      <!-- Grid header -->
      <div class="grid grid-cols-[1fr_90px_110px_110px] border-b border-night-700 bg-night-950/40 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-ink-faint">
        <span>Name</span>
        <span class="text-right">Size</span>
        <span class="text-right">Modified</span>
        <span class="text-right">Storage</span>
      </div>

      <!-- Rows -->
      <ul class="text-xs">
        {rows.map((r) => (
          <li
            class:list={[
              'grid grid-cols-[1fr_90px_110px_110px] items-center px-3 py-2 border-b border-night-800/60',
              r.selected ? 'bg-brand-500/10' : '',
            ]}
          >
            <span class="flex min-w-0 items-center gap-2">
              {r.icon === 'folder' ? (
                <Icon name="heroicons:folder-16-solid" width="15" height="15" aria-hidden="true" class="shrink-0 text-brand-400" />
              ) : (
                <Icon name="heroicons:document-16-solid" width="15" height="15" aria-hidden="true" class="shrink-0 text-ink-faint" />
              )}
              <span class:list={['truncate', r.muted ? 'text-ink-muted' : 'text-ink', r.selected ? 'font-medium' : '']}>{r.name}</span>
            </span>
            <span class="text-right tabular-nums text-ink-muted">{r.size}</span>
            <span class="text-right tabular-nums text-ink-muted">{r.modified}</span>
            <span class="text-right">
              <span class="rounded bg-night-800 px-1.5 py-0.5 text-[10px] text-ink-faint">{r.klass}</span>
            </span>
          </li>
        ))}
      </ul>

      <!-- Status bar -->
      <div class="flex items-center justify-between px-3 py-1.5 text-[11px] text-ink-faint">
        <span>7 items · 1 selected</span>
        <span class="tabular-nums">1.7 GB scanned</span>
      </div>
    </div>
  </div>
</div>
